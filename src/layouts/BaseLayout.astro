---
import BaseHead from '../components/BaseHead.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
}

const { title, description, image, type, publishedTime } = Astro.props;
---

<html lang="en" class="scroll-smooth">
  <head>
    <BaseHead title={title} description={description} image={image} type={type} publishedTime={publishedTime} />
  </head>
  <body class="bg-[#061219] text-white min-h-screen font-sans selection:bg-[#00E5CC] selection:text-black">
    <!-- Prvi Tab na stranici: preskače navigaciju (svaka stranica ima <main id="main">) -->
    <a href="#main" class="skip-link">Skip to content</a>
    <Navbar />
    <slot />
    <Footer />
    <ScrollToTop />

    <script>
      import '../scripts/scrollReveal.js';
    </script>
  </body>
</html>
