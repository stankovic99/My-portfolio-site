---
import Icon from './Icon.astro';
---

<button
  id="scroll-top"
  type="button"
  aria-label="Back to top"
  inert
  class="fixed bottom-6 right-6 md:bottom-8 md:right-8 z-40 flex h-12 w-12 items-center justify-center rounded-[14px] bg-[#00E5CC] text-[#061219] shadow-[0_12px_30px_rgba(0,0,0,0.45)] transition-all duration-300 hover:bg-white hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#00E5CC] focus-visible:ring-offset-2 focus-visible:ring-offset-[#061219] opacity-0 translate-y-4 pointer-events-none"
>
  <Icon name="arrow-up" class="h-5 w-5" />
</button>

<script>
  const btn = document.getElementById('scroll-top');
  const hiddenClasses = ['opacity-0', 'translate-y-4', 'pointer-events-none'];

  if (btn) {
    const toggle = () => {
      const hidden = window.scrollY < 400;
      hiddenClasses.forEach((cls) => btn.classList.toggle(cls, hidden));
      // Sakriveno dugme ne sme da primi fokus (Tab) niti da ga čuje čitač ekrana
      btn.inert = hidden;
    };

    window.addEventListener('scroll', toggle, { passive: true });
    toggle();

    btn.addEventListener('click', () => {
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
    });
  }
</script>
