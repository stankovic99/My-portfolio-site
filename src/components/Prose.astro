---
import type { HTMLAttributes } from 'astro/types';

// Omotač za Markdown sadržaj (typography stilovi na jednom mestu)
type Props = HTMLAttributes<'article'>;

const { class: className, ...rest } = Astro.props;
---

<article
  class:list={[
    `max-w-none md:max-w-4xl mx-auto prose prose-invert prose-lg
    prose-headings:font-sans prose-headings:font-bold prose-headings:text-white
    prose-p:font-mono prose-p:text-gray-400 prose-p:leading-relaxed
    prose-a:text-[#00E5CC] prose-a:no-underline hover:prose-a:underline
    prose-strong:text-white prose-strong:font-bold
    prose-img:rounded-3xl prose-img:border prose-img:border-gray-800 prose-img:shadow-2xl prose-img:w-full`,
    className,
  ]}
  {...rest}
>
  <slot />
</article>
