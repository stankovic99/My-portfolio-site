---
import { Image } from 'astro:assets';
import { certifications } from '../data/certifications';
import { formatMonth } from '../utils/content';

export interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<section class:list={['section-wrapper', className]}>
  <div class="container-custom">
    <div class="mb-16 flex flex-col gap-3 text-center lg:text-left fade-in-up">
      <span class="pill-badge self-center lg:self-start">Certifications</span>
      <h2 class="heading-section">Certifications</h2>
    </div>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {certifications.map(({ code, name, date, credentialUrl, badge }, i) => (
        <article class="card-base justify-start gap-4 fade-in-up" style={`animation-delay: ${100 + i * 100}ms;`}>
          <div class="flex items-center gap-4">
            {badge ? (
              <>
                <Image src={badge} alt={`${code} badge`} width={64} height={64} densities={[1, 2]} class="h-16 w-16 object-contain" />
                <span class="font-mono text-xs uppercase tracking-widest text-[#00E5CC]">{code}</span>
              </>
            ) : (
              <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-xl border border-[#00E5CC]/20 bg-[#00E5CC]/10 font-mono text-sm font-bold text-[#00E5CC]">
                {code}
              </div>
            )}
          </div>
          <h3 class="card-title mb-0 text-xl">{name}</h3>
          {date && (
            <p class="font-mono text-xs uppercase tracking-widest text-gray-400">
              <time datetime={date}>{formatMonth(date)}</time>
            </p>
          )}
          {credentialUrl && (
            <a href={credentialUrl} target="_blank" rel="noopener noreferrer" class="mt-auto inline-flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-gray-400 hover:text-[#00E5CC] transition-colors">
              View credential <span aria-hidden="true">↗</span>
            </a>
          )}
        </article>
      ))}
    </div>
  </div>
</section>
