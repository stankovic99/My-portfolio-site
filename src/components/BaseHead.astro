---
import { Font } from 'astro:assets';

// Definišemo koje podatke komponenta očekuje
export interface Props {
  title: string;
  description: string;
  image?: string;
  canonicalURL?: string | URL;
}

const {
  title,
  description,
  // Ako ne proslediš sliku, koristi se 1200x630 preview iz public foldera
  image = '/og-image.png',
  // Automatski generiše tačan URL trenutne stranice
  canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://stefanstankovic.me'),
} = Astro.props;

// Pravimo apsolutni URL za sliku (mreže to zahtevaju)
const socialImageURL = new URL(image, Astro.url);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#040D14" />

<meta name="generator" content={Astro.generator} />

<link rel="canonical" href={canonicalURL} />

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImageURL} />
{!Astro.props.image && (
  <>
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Stefan Stankovic, Dynamics 365 F&O, Power Platform and Web Developer" />
  </>
)}

<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={socialImageURL} />

<Font cssVariable="--font-bricolage" preload />
<Font cssVariable="--font-instrument" />
<Font cssVariable="--font-jetbrains" preload />