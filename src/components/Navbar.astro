---
// src/components/Navbar.astro
// Pravilan import slike iz src foldera (putanja je relativna u odnosu na komponentu)
import logo from '../images/logo.svg';
import { navLinks, contactLink } from '../data/nav';
import Icon from './Icon.astro';

// Projekti pripadaju Portfolio sekciji, postovi Blog sekciji.
// Skidamo završnu kosu crtu i sa putanje i sa href-a pre poređenja.
const stripSlash = (url: string) => url.replace(/\/$/, '') || '/';
const path = stripSlash(Astro.url.pathname);
const isActive = (href: string) => {
  const target = stripSlash(href);
  if (target === '/') return path === '/';
  if (target === '/portfolio') return path === target || path.startsWith('/projects/');
  return path === target || path.startsWith(`${target}/`);
};
---

<nav class="w-full bg-[#061219]/85 backdrop-blur-md border-b border-[#00E5CC]/10 text-white fixed top-0 z-50">
  <div class="container-custom py-3 flex justify-between items-center gap-6">

    <a href="/" class="z-50 flex items-center justify-center">
      <img src={logo.src} width={logo.width} height={logo.height} alt="Stefan Stankovic, home" class="h-8 md:h-10 w-auto object-contain" />
    </a>

    <!-- Navigacioni linkovi (desktop), grupisani u "pill" okvir; aktivna stranica dobija cyan pozadinu -->
    <div class="hidden md:flex items-center gap-1 rounded-xl border border-gray-800 bg-[#0A1A22] p-1">
      {navLinks.map(({ href, label }) => (
        <a
          href={href}
          aria-current={isActive(href) ? 'page' : undefined}
          class:list={[
            'ui-text text-[13px] px-4 py-2 rounded-lg transition-colors duration-200',
            isActive(href) ? 'text-[#00E5CC] bg-[#00E5CC]/10' : 'text-gray-300 hover:text-white hover:bg-white/5',
          ]}
        >
          {label}
        </a>
      ))}
    </div>

    <!-- CTA Dugme -->
    <a href={contactLink.href} aria-current={isActive(contactLink.href) ? 'page' : undefined} class="btn-primary hidden md:inline-flex text-[13px] px-5 py-2.5">
      <Icon name="mail" class="h-4 w-4" />
      {contactLink.label}
    </a>

    <!-- Mobilni meni ikonica -->
    <button id="mobile-menu-btn" type="button" aria-label="Toggle menu" aria-controls="mobile-menu" aria-expanded="false" class="md:hidden rounded-lg p-1 text-gray-300 hover:text-[#00E5CC] focus-visible:outline-2 focus-visible:outline-[#00E5CC] z-50">
      <Icon name="menu" class="w-8 h-8" />
    </button>
  </div>

  <!-- Padajući meni za mobilne -->
  <div id="mobile-menu" class="hidden absolute top-full left-0 w-full bg-[#061219] border-b border-[#00E5CC]/10 flex-col items-center py-8 gap-3 shadow-2xl">
    {navLinks.map(({ href, label }) => (
      <a
        href={href}
        aria-current={isActive(href) ? 'page' : undefined}
        class:list={[
          'mobile-link ui-text text-sm px-5 py-3 rounded-lg transition-colors',
          isActive(href) ? 'text-[#00E5CC] bg-[#00E5CC]/10' : 'text-gray-300 hover:text-white',
        ]}
      >
        {label}
      </a>
    ))}
    <a href={contactLink.href} aria-current={isActive(contactLink.href) ? 'page' : undefined} class="mobile-link btn-primary mt-4">
      <Icon name="mail" class="h-4 w-4" />
      {contactLink.label}
    </a>
  </div>
</nav>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const links = document.querySelectorAll('.mobile-link');

    if (btn && menu) {
      btn.addEventListener('click', () => {
        const isOpen = menu.classList.toggle('flex');
        menu.classList.toggle('hidden', !isOpen);
        btn.setAttribute('aria-expanded', String(isOpen));
      });

      links.forEach(link => {
        link.addEventListener('click', () => {
          menu.classList.add('hidden');
          menu.classList.remove('flex');
          btn.setAttribute('aria-expanded', 'false');
        });
      });
    }
  });
</script>
