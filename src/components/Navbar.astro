---
// src/components/Navbar.astro
// Pravilan import slike iz src foldera (putanja je relativna u odnosu na komponentu)
import logo from '../images/logo.svg';

const links = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/portfolio', label: 'Portfolio' },
  { href: '/blog', label: 'Blog' },
];

// Projekti pripadaju Portfolio sekciji, postovi Blog sekciji
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  if (href === '/') return path === '/';
  if (href === '/portfolio') return path === href || path.startsWith('/projects/');
  return path === href || path.startsWith(`${href}/`);
};
---

<nav class="w-full bg-[#040D14]/95 backdrop-blur-md border-b border-gray-800 text-white fixed top-0 z-50">
  <div class="max-w-7xl mx-auto px-6 md:px-12 py-3 flex justify-between items-center">

    <a href="/" class="z-50 flex items-center justify-center">
      <img src={logo.src} width={logo.width} height={logo.height} alt="Stefan Stankovic Logo" class="h-8 md:h-10 w-auto object-contain" />
    </a>

    <!-- Navigacioni Linkovi (Desktop) -->
    <div class="hidden md:flex space-x-8 text-sm font-sans font-semibold uppercase tracking-widest text-gray-300 items-center">
      {links.map(({ href, label }) => (
        <a
          href={href}
          aria-current={isActive(href) ? 'page' : undefined}
          class:list={['hover:text-[#00E5CC] transition-colors duration-200', { 'text-[#00E5CC]': isActive(href) }]}
        >
          {label}
        </a>
      ))}
    </div>

    <!-- CTA Dugme -->
    <a href="/contact" aria-current={isActive('/contact') ? 'page' : undefined} class="hidden md:inline-flex items-center justify-center bg-[#00E5CC] text-[#040D14] hover:bg-white px-6 py-2.5 rounded-sm text-sm font-bold uppercase tracking-wider transition-all duration-300">
      CONTACT
    </a>

    <!-- Mobilni meni ikonica -->
    <button id="mobile-menu-btn" type="button" aria-label="Toggle menu" aria-controls="mobile-menu" aria-expanded="false" class="md:hidden text-gray-300 hover:text-[#00E5CC] focus:outline-none z-50">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>

  <!-- Padajući meni za mobilne -->
  <div id="mobile-menu" class="hidden absolute top-full left-0 w-full bg-[#040D14] border-b border-gray-800 flex-col items-center py-8 space-y-6 shadow-2xl">
    {links.map(({ href, label }) => (
      <a
        href={href}
        aria-current={isActive(href) ? 'page' : undefined}
        class:list={[
          'mobile-link hover:text-[#00E5CC] text-lg font-bold uppercase tracking-widest',
          isActive(href) ? 'text-[#00E5CC]' : 'text-gray-300',
        ]}
      >
        {label}
      </a>
    ))}
    <a href="/contact" aria-current={isActive('/contact') ? 'page' : undefined} class="mobile-link bg-[#00E5CC] text-[#040D14] px-10 py-3.5 rounded-sm font-bold uppercase tracking-wider mt-4">CONTACT</a>
  </div>
</nav>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const links = document.querySelectorAll('.mobile-link');

    if (btn && menu) {
      btn.addEventListener('click', () => {
        const isOpen = menu.classList.toggle('flex');
        menu.classList.toggle('hidden', !isOpen);
        btn.setAttribute('aria-expanded', String(isOpen));
      });

      links.forEach(link => {
        link.addEventListener('click', () => {
          menu.classList.add('hidden');
          menu.classList.remove('flex');
          btn.setAttribute('aria-expanded', 'false');
        });
      });
    }
  });
</script>
