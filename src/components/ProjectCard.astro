---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';

export interface Props {
  project: CollectionEntry<'projects'>;
  delay?: number;
  // Kartice u prvom redu mogu da se učitaju odmah
  loading?: 'lazy' | 'eager';
}

const { project, delay = 150, loading = 'lazy' } = Astro.props;
const { title, description, heroImage, tags } = project.data;
---

<!-- Slika ide od ivice do ivice, zato card-base bez paddinga -->
<a href={`/projects/${project.id}/`} class="card-base group relative justify-start overflow-hidden p-0 md:p-0 fade-in-up" style={`animation-delay: ${delay}ms;`}>
  <div class="aspect-video w-full overflow-hidden bg-[#061219] relative">
    <Image
      src={heroImage}
      alt={`${title} preview`}
      widths={[480, 800]}
      sizes="(min-width: 768px) 50vw, 100vw"
      loading={loading}
      class="absolute inset-0 h-full w-full object-cover group-hover:scale-105 transition-transform duration-700"
    />
  </div>
  <div class="flex flex-1 flex-col gap-4 p-6 md:px-8 md:pt-7 md:pb-8">
    <h3 class="card-title mb-0">{title}</h3>
    <p class="text-gray-400 font-mono leading-relaxed text-sm">{description}</p>
    <div class="flex flex-wrap gap-2">
      {tags.map((tag) => <span class="tag">{tag}</span>)}
    </div>
    <span class="mt-auto pt-2 inline-flex items-center gap-2 ui-text text-[13px] text-[#00E5CC]">
      Read case study <Icon name="arrow-up-right" class="h-4 w-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
    </span>
  </div>
</a>
