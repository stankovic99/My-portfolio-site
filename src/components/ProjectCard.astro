---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Props {
  href: string;
  title: string;
  description: string;
  image: ImageMetadata;
  tags: string[];
  delay?: number;
}

const { href, title, description, image, tags, delay = 150 } = Astro.props;
---

<a href={href} class="card-base group relative fade-in-up" style={`animation-delay: ${delay}ms;`}>
  <div>
    <div class="mb-6 aspect-video w-full overflow-hidden rounded-xl border border-gray-800 bg-[#040D14] relative">
      <Image
        src={image}
        alt={`${title} preview`}
        widths={[480, 800]}
        sizes="(min-width: 768px) 50vw, 100vw"
        class="absolute inset-0 h-full w-full object-cover group-hover:scale-105 transition-transform duration-700"
      />
    </div>
    <h3 class="card-title">{title}</h3>
    <p class="text-gray-400 leading-relaxed text-sm mb-6">{description}</p>
  </div>
  <div class="flex flex-wrap gap-2">
    {tags.map((tag) => <span class="tag">{tag}</span>)}
  </div>
</a>
