---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostCard from '../components/PostCard.astro';
import Certifications from '../components/Certifications.astro';
import ContactCta from '../components/ContactCta.astro';
import CodeWindow from '../components/CodeWindow.astro';
import Icon from '../components/Icon.astro';
import { getFeaturedProjects, getPosts, yearsSince } from '../utils/content';
import { linkedInUrl } from '../data/nav';
import { skills } from '../data/skills';
import { certifications } from '../data/certifications';
import { d365Start } from '../data/experience';
import bgImage from '../images/bg.png';

const pageTitle = "Stefan Stankovic | D365 F&O Developer";
const pageDescription = "Enterprise architecture and high-performance web systems.";

const featuredProjects = await getFeaturedProjects();
// Tri najnovija posta za sekciju "Latest posts"
const latestPosts = (await getPosts()).slice(0, 3);

// Činjenice ispod dugmadi u Hero sekciji
const heroFacts = [
  { icon: 'briefcase', text: `${yearsSince(d365Start)}+ years as a D365 F&O developer` },
  { icon: 'badge-check', text: `${certifications.length} Microsoft certifications` },
  { icon: 'map-pin', text: 'Skopje · hybrid' },
] as const;

// Navike rada pored naslova sekcije "What I do"
const principles = [
  { icon: 'clipboard-list', text: 'Plan first' },
  { icon: 'feather', text: 'Keep it simple' },
  { icon: 'shield-check', text: 'Test properly' },
] as const;

// Kartice za sekciju "What I do"
const disciplines = [
  {
    icon: 'database',
    title: 'Dynamics 365 F&O',
    body: 'I write X++ for Finance & Operations. I extend the standard system, connect it to other tools and fix what slows it down.',
    points: ['Data models that fit the business', 'Extensions and integrations', 'Finding and fixing slow code'],
    footer: 'D365 F&O · X++ · SQL',
  },
  {
    icon: 'workflow',
    title: 'Power Platform',
    body: 'When a process runs on emails and spreadsheets, I turn it into a flow or an app that people actually use.',
    points: ['Power Automate flows', 'Model-driven and canvas apps', 'Safe connections between systems'],
    footer: 'Automate · Apps · Pages',
  },
  {
    icon: 'code-xml',
    title: 'Websites',
    body: 'Fast sites with a simple structure, so the people who own them can update them without calling me.',
    points: ['Fast load times', 'Content you can edit yourself', 'More than one language'],
    footer: 'Astro · Webflow · Tailwind',
  },
] as const;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main id="main">

    <!-- HERO -->
    <section class="relative container-custom pt-32 pb-16 md:pt-40 md:pb-24 flex flex-col md:flex-row items-center justify-center md:justify-between gap-12 min-h-[100svh] w-full">

      <div class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.02)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.02)_1px,transparent_1px)] bg-[size:40px_40px] [mask-image:radial-gradient(ellipse_80%_80%_at_50%_50%,#000_20%,transparent_100%)] z-0 pointer-events-none"></div>
      <div class="absolute top-1/3 left-1/2 -translate-x-1/2 md:translate-x-0 md:left-auto md:right-10 w-[300px] h-[300px] bg-[#00E5CC]/10 rounded-full blur-[100px] z-0 pointer-events-none"></div>

      <div class="w-full md:w-3/5 z-10 flex flex-col gap-7 items-center md:items-start text-center md:text-left relative">

        <div class="flex flex-wrap justify-center md:justify-start gap-2.5 fade-in-up" style="animation-delay: 0ms;">
          <span class="inline-flex items-center gap-2 rounded-full border border-[#00E5CC]/30 bg-[#00E5CC]/10 px-3.5 py-1.5 ui-text text-xs text-[#00E5CC]">
            <span class="h-2 w-2 rounded-full bg-[#00E5CC] shadow-[0_0_0_4px_rgba(0,229,204,0.2)]" aria-hidden="true"></span>
            Dynamics 365 F&O developer
          </span>
          <a href={linkedInUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-full border border-white/20 px-3.5 py-1.5 ui-text text-xs text-gray-300 hover:border-[#00E5CC] hover:text-white transition-colors">
            <Icon name="linkedin" class="h-3.5 w-3.5" />
            LinkedIn
          </a>
        </div>

        <h1 class="fade-in-up heading-primary" style="animation-delay: 100ms;">
          Hi, I'm Stefan.<br />
          <span class="font-serif italic font-normal tracking-normal text-[#00E5CC]">I build business software.</span>
        </h1>

        <p class="fade-in-up text-body max-w-xl" style="animation-delay: 200ms;">
          Dynamics 365 F&O, Power Platform and web developer. I connect heavy ERP processes with fast, modern frontends, and keep the code simple enough to keep working.
        </p>

        <div class="fade-in-up flex flex-col sm:flex-row items-center justify-center md:justify-start gap-3 w-full" style="animation-delay: 300ms;">
          <a href={featuredProjects.length > 0 ? "#portfolio" : "/portfolio/"} class="btn-primary w-full sm:w-auto">
            View case studies <Icon name="arrow-right" class="h-4 w-4" />
          </a>
          <a href="/blog/" class="btn-secondary w-full sm:w-auto">
            <Icon name="book-open" class="h-4 w-4" /> Read the blog
          </a>
        </div>

        <ul class="fade-in-up flex flex-wrap justify-center md:justify-start gap-x-7 gap-y-3 w-full pt-5 border-t border-gray-800 text-[15px] text-gray-300" style="animation-delay: 400ms;">
          {heroFacts.map(({ icon, text }) => (
            <li class="flex items-center gap-2.5">
              <Icon name={icon} class="h-5 w-5 text-[#00E5CC]" />{text}
            </li>
          ))}
        </ul>

      </div>

      <div class="hidden md:flex w-2/5 justify-end items-end relative min-h-[400px] lg:min-h-[500px] fade-in-up" style="animation-delay: 500ms;">
        <div class="relative w-[88%]">
          <!-- Pozadina iza fotografije: prozor editora sa X++ kodom (više viri levo, ka tekstu, da desno ne izađe iz ekrana) -->
          <CodeWindow class="-left-[20%] -right-[6%] top-[6%] h-[74%]" />
          <Image
            src={bgImage}
            alt="Stefan Stankovic"
            widths={[400, 640]}
            sizes="(min-width: 1280px) 400px, 32vw"
            loading="eager"
            fetchpriority="high"
            class="w-full object-contain relative z-10 drop-shadow-2xl"
          />
        </div>
        <div class="absolute bottom-0 left-0 w-full h-32 bg-gradient-to-t from-[#061219] to-transparent z-20 pointer-events-none"></div>
      </div>

    </section>

    <!-- MARQUEE -->
    <section class="marquee-container marquee-fade w-full bg-[#081820] border-y border-gray-800/50 py-5 overflow-hidden relative select-none">
      <!-- Trajanje raste sa brojem stavki (5s po stavci) da brzina ostane ista -->
      <div class="animate-marquee" style={`animation-duration: ${skills.length * 5}s;`}>
        {[false, true].map((duplicate) => (
          <ul class="flex items-center m-0" aria-hidden={duplicate ? 'true' : undefined}>
            {skills.map((skill) => (
              <li class="flex items-center gap-3 px-6 md:px-9 font-mono text-sm md:text-[15px] tracking-[0.08em] uppercase text-gray-300 whitespace-nowrap">
                <span class="h-1.5 w-1.5 rounded-full bg-[#00E5CC]" aria-hidden="true"></span>
                {skill}
              </li>
            ))}
          </ul>
        ))}
      </div>
    </section>

    <!-- WHAT I DO -->
    <section class="container-custom py-24 md:py-28">

      <!-- Naslov levo, navike desno u istom redu (od lg naviše) -->
      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-8 mb-14 reveal-on-scroll opacity-0 translate-y-10 transition-all duration-700 ease-out">
        <div class="flex flex-col gap-4">
          <span class="eyebrow">What I do</span>
          <h2 class="heading-section">
            Three kinds of work.<br />
            <span class="font-serif italic font-normal tracking-normal text-[#00E5CC]">Same habits for each.</span>
          </h2>
        </div>
        <ul class="flex flex-wrap lg:justify-end gap-2.5">
          {principles.map(({ icon, text }) => (
            <li class="flex items-center gap-2 rounded-xl border border-gray-800 px-4 py-2.5 text-gray-300">
              <Icon name={icon} class="h-[18px] w-[18px] text-[#00E5CC]" />{text}
            </li>
          ))}
        </ul>
      </div>

      <!-- Omotač nosi reveal animaciju i kašnjenje; da su na samoj kartici, kasnio bi i njen hover -->
      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {disciplines.map(({ icon, title, body, points, footer }, i) => (
          <div class="reveal-on-scroll opacity-0 translate-y-10 transition-all duration-700 ease-out" style={`transition-delay: ${i * 100}ms;`}>
            <article class="card-base h-full justify-start gap-5 rounded-[20px]">
              <span class="flex h-[52px] w-[52px] items-center justify-center rounded-[14px] bg-[#00E5CC]/10 text-[#00E5CC]">
                <Icon name={icon} class="h-[26px] w-[26px]" />
              </span>
              <h3 class="card-title mb-0 text-[22px]">{title}</h3>
              <p class="font-mono text-sm leading-relaxed text-gray-400">{body}</p>
              <ul class="flex flex-col gap-2.5 text-[15px] text-gray-300">
                {points.map((point) => (
                  <li class="flex items-center gap-2.5">
                    <Icon name="check" class="h-[18px] w-[18px] text-[#00E5CC]" />{point}
                  </li>
                ))}
              </ul>
              <p class="mt-auto pt-5 border-t border-gray-800 font-mono text-[13px] text-[#00E5CC]">{footer}</p>
            </article>
          </div>
        ))}
      </div>
    </section>

    <Certifications class="bg-[#081820] border-b border-gray-800/50" />

    <!-- LATEST POSTS (samo ako postoje postovi) -->
    {latestPosts.length > 0 && (
      <section class="container-custom py-24 md:py-28">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-6 mb-10 reveal-on-scroll opacity-0 translate-y-10 transition-all duration-700 ease-out">
          <div class="flex flex-col gap-4">
            <span class="eyebrow">From the blog</span>
            <h2 class="heading-section">Latest posts.</h2>
          </div>
          <a href="/blog/" class="btn-secondary">
            All posts <Icon name="arrow-right" class="h-4 w-4" />
          </a>
        </div>

        <!-- Iste kartice kao na /blog; tri u redu od lg naviše. Reveal je na omotaču da hover kartice ne kasni -->
        <div class="grid gap-5 lg:grid-cols-3">
          {latestPosts.map((post, i) => (
            <div class="reveal-on-scroll opacity-0 translate-y-10 transition-all duration-700 ease-out" style={`transition-delay: ${i * 100}ms;`}>
              <PostCard post={post} headingLevel={3} />
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- SELECTED WORK (samo ako postoje featured projekti); svetlija pozadina da se odvoji od postova -->
    {featuredProjects.length > 0 && (
      <section id="portfolio" class="bg-[#081820] border-y border-gray-800/50">
        <div class="container-custom py-24 md:py-28">
          <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-6 mb-12 reveal-on-scroll opacity-0 translate-y-10 transition-all duration-700 ease-out">
            <div class="flex flex-col gap-4">
              <span class="eyebrow">Selected work</span>
              <h2 class="heading-section">Engineered platforms.</h2>
            </div>
            <a href="/portfolio/" class="btn-secondary">
              All projects <Icon name="arrow-right" class="h-4 w-4" />
            </a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 auto-rows-fr">
            {featuredProjects.map((p, i) => <ProjectCard project={p} delay={150 + i * 50} />)}
          </div>
        </div>
      </section>
    )}

    <!-- CONTACT CTA: gornji razmak treba kad je sekcija iznad druge boje (projekti ili sertifikati) -->
    <ContactCta class:list={['pb-24 md:pb-28', { 'pt-24 md:pt-28': featuredProjects.length > 0 || latestPosts.length === 0 }]} />

  </main>
</BaseLayout>
