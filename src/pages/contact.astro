---
import type { ComponentProps } from 'astro/types';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { email, githubUrl, linkedInUrl } from '../data/nav';

const pageTitle = "Stefan Stankovic | Contact";
const pageDescription = "Contact Stefan Stankovic about Dynamics 365, Power Platform or a post on the blog.";

type IconName = ComponentProps<typeof Icon>['name'];

// Redovi u levoj koloni (bez `href` red je običan tekst, bez hovera)
const contactRows: { icon: IconName; label: string; text: string; href?: string }[] = [
  { icon: 'mail', label: 'Email', text: email, href: `mailto:${email}` },
  { icon: 'map-pin', label: 'Location', text: 'Skopje, North Macedonia' },
];

const socialLinks: { icon: IconName; label: string; href: string }[] = [
  { icon: 'linkedin', label: 'LinkedIn', href: linkedInUrl },
  { icon: 'github', label: 'GitHub', href: githubUrl },
];

// Zajedničke klase za male natpise i polja forme
const labelClass = 'font-mono text-xs text-gray-400 uppercase tracking-widest';
const fieldClass = 'rounded-xl border border-gray-700 bg-[#061219] px-5 py-4 text-white placeholder-gray-500 focus:border-[#00E5CC] focus:outline-none focus:ring-1 focus:ring-[#00E5CC] transition-colors';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main id="main" class="pt-32 pb-20">

    <!-- Dve kolone od vrha: levo naslov i direktan email, desno odmah forma -->
    <section class="container-custom">
      <div class="grid items-start lg:grid-cols-12 gap-12 lg:gap-20">

        <div class="lg:col-span-5 fade-in-up">
          <div class="mb-10 flex flex-col gap-5">
            <span class="eyebrow">Contact</span>
            <h1 class="heading-page mb-0">Get in touch.</h1>
            <p class="text-body">
              Questions about Dynamics 365 or Power Platform, feedback on a blog post, or just want to say hi? Email me directly, or use the form.
            </p>
          </div>

          <div class="space-y-8">
            {contactRows.map(({ icon, label, text, href }) => (
              <div class="group flex items-start gap-4">
                <div class:list={[
                  'flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-gray-800 bg-[#0A1A22] text-[#00E5CC]',
                  href && 'transition-colors group-hover:border-[#00E5CC]/50',
                ]}>
                  <Icon name={icon} />
                </div>
                <div>
                  <p class:list={[labelClass, 'mb-1']}>{label}</p>
                  {href ? (
                    <a href={href} class="text-base md:text-lg text-gray-300 hover:text-[#00E5CC] transition-colors break-all">{text}</a>
                  ) : (
                    <p class="text-base md:text-lg text-gray-300">{text}</p>
                  )}
                </div>
              </div>
            ))}
          </div>

          <div class="mt-12 pt-8 border-t border-gray-800">
            <p class:list={[labelClass, 'mb-4']}>Professional Network</p>
            <div class="flex gap-4">
              {socialLinks.map(({ icon, label, href }) => (
                <a href={href} target="_blank" rel="noopener noreferrer" aria-label={`${label} (opens in a new tab)`} class="inline-flex items-center justify-center h-10 w-10 rounded-full bg-[#0A1A22] border border-gray-800 text-gray-400 hover:border-[#00E5CC] hover:text-[#00E5CC] transition-all">
                  <Icon name={icon} class="h-4 w-4" />
                </a>
              ))}
            </div>
          </div>
        </div>

        <div class="lg:col-span-7 fade-in-up" style="animation-delay: 150ms;">
          <div class="rounded-3xl border border-gray-800 bg-[#0A1A22] p-6 md:p-10 shadow-[0_18px_40px_rgba(0,0,0,0.35)]">
            <h2 class="mb-6 text-2xl font-bold text-white">Send a message</h2>

            <!-- Bez JS-a forma se šalje običnim POST-om na Web3Forms; sa JS-om je preuzima contactForm.js -->
            <form id="contact-form" action="https://api.web3forms.com/submit" method="POST" class="flex flex-col gap-6 relative">
              <input type="hidden" name="access_key" value="bf5fb5c5-6ad9-4ae7-8d91-812e7237b598">
              <input type="hidden" name="subject" value="New Contact from Portfolio Website">
              <!-- Zamka za botove (Web3Forms odbacuje poruku ako je označeno) -->
              <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off">

              <div class="flex flex-col gap-2">
                <label for="name" class={labelClass}>Name</label>
                <input type="text" id="name" name="name" required autocomplete="name" placeholder="Your name" class={fieldClass} />
              </div>

              <div class="flex flex-col gap-2">
                <label for="email" class={labelClass}>Email</label>
                <input type="email" id="email" name="email" required autocomplete="email" placeholder="you@example.com" class={fieldClass} />
              </div>

              <div class="flex flex-col gap-2 mt-2">
                <label for="message" class={labelClass}>Message</label>
                <textarea id="message" name="message" rows="5" required placeholder="Your question, feedback or just a hello" class:list={[fieldClass, 'resize-none']}></textarea>
              </div>

              <!-- Poruka o grešci (popunjava je contactForm.js); role="alert" je čita čitaču ekrana -->
              <p id="form-error" role="alert" class="hidden rounded-xl border border-gray-700 bg-[#061219] px-5 py-4 font-mono text-sm text-gray-300"></p>

              <button type="submit" class="btn-primary mt-4 w-full md:w-auto disabled:opacity-50 disabled:cursor-not-allowed">
                <span>Send Message</span>
                <Icon name="arrow-right" class="h-4 w-4" />
              </button>

              <div id="success-message" role="status" class="hidden absolute inset-0 bg-[#0A1A22] flex-col items-center justify-center z-10">
                <div class="h-16 w-16 bg-[#00E5CC]/10 text-[#00E5CC] rounded-full flex items-center justify-center mb-4">
                  <Icon name="check" class="h-8 w-8" />
                </div>
                <h3 class="text-xl font-sans font-bold text-white mb-2">Message Sent</h3>
                <p class="font-mono text-sm text-gray-400">I'll get back to you shortly.</p>
              </div>

            </form>
          </div>
        </div>

      </div>
    </section>

  </main>

  <script src="../scripts/contactForm.js"></script>
</BaseLayout>
