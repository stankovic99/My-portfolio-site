---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Certifications from '../components/Certifications.astro';
import { skills } from '../data/skills';
import bgImage from '../images/bg.png';

const pageTitle = "Stefan Stankovic | About";
const pageDescription = "Serious Architecture. Zero Bloat. Bridging the gap between heavy enterprise systems and the modern web.";

// Kartice za sekciju "What I do"
const services = [
  {
    eyebrow: 'ENTERPRISE LOGIC',
    title: 'Dynamics 365 F&O Architecture',
    role: 'Intermediate Technical Consultant',
    body: "This is my day-to-day engine. I write robust X++ business logic, execute complex data migrations, and customize modules for large-scale enterprise environments. If your ERP system needs stable, scalable customizations that won't break during Microsoft updates, this is where I come in.",
    tags: ['D365 F&O', 'X++', 'ERP'],
  },
  {
    eyebrow: 'AUTOMATION & APPS',
    title: 'Microsoft Power Platform',
    role: 'Certified Power Platform Developer',
    body: "Bridging the gaps between your disconnected systems. I build custom workflows, model-driven apps, and automated processes using Power Apps, Power Automate and Power Pages. It's all about eliminating manual bottlenecks and securely making your data work for you.",
    tags: ['Power Apps', 'Power Automate', 'Power Pages'],
  },
  {
    eyebrow: 'HIGH-PERFORMANCE UI',
    title: 'Modern Frontend Execution',
    role: 'Full-Stack Developer',
    body: "I don't use heavy, bloated templates. I build lightning-fast, visually precise frontend architectures using Astro and Webflow, strictly styled with utility-first CSS frameworks like Tailwind. The result is a premium digital presence that loads instantly and scales flawlessly across all devices.",
    tags: ['Astro', 'Webflow', 'Tailwind'],
  },
  {
    eyebrow: 'DATA STRUCTURES',
    title: 'Backend & CMS Architecture',
    role: 'Full-Stack Developer',
    body: "A beautiful frontend needs a smart backend. I set up decoupled content architectures using Sanity, Webflow CMS, or dedicated backend engines like Xano. This gives you a secure, intuitive dashboard to manage your content and data without ever having to touch the source code.",
    tags: ['Sanity', 'Webflow CMS', 'Xano'],
  },
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
    <main class="pt-32 pb-20">
      
      <section class="container-custom mb-20 md:mb-32">
        <div class="grid items-center gap-10 lg:grid-cols-[1.05fr_0.95fr]">
          
          <article class="fade-in-up order-1 lg:order-2">
            <div class="group relative mx-auto w-full max-w-md overflow-hidden rounded-3xl border border-gray-800 bg-[#08131D] p-4 shadow-xl transition-all duration-500 hover:-translate-y-1 hover:border-[#00E5CC]/50 hover:shadow-[0_0_35px_rgba(0,229,204,0.1)]">
              <Image
                src={bgImage}
                alt="Stefan Stankovic"
                widths={[400, 800]}
                sizes="(min-width: 448px) 448px, 100vw"
                loading="eager"
                class="relative h-full w-full rounded-2xl object-cover"
              />
              <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(0,229,204,0.08),transparent_30%)] opacity-0 transition duration-500 group-hover:opacity-100 pointer-events-none"></div>
            </div>
          </article>

          <article class="fade-in-up order-2 lg:order-1 text-center md:text-left" style="animation-delay: 100ms;">
            
            <p class="pill-badge">About Me</p>
            
            <h1 class="heading-page">
              The story so far.
            </h1>
            
            <p class="text-body mb-6 max-w-2xl mx-auto md:mx-0">
              With nearly eight years in the IT world — and the last five deeply 
              immersed in enterprise software as a Dynamics 365 F&O Developer — 
              my foundation is built on heavy business logic. 
              I've spent my career architecting complex integrations and ensuring 
              large-scale systems run flawlessly under the hood.</p>
            
            <p class="text-body mb-10 max-w-2xl mx-auto md:mx-0">
              But my curiosity doesn't stop at the backend. I actively explore the modern web space, 
              building fast, scalable platforms with Astro, Webflow, and headless CMS integrations. 
              I’m driven by continuous learning. Whether it’s adapting to AI-assisted workflows, 
              exploring new tech trends, or just writing clean code, my goal remains the same: 
              <span class="text-white font-bold">solving real problems and constantly evolving as an engineer.</span>
            </p>

            <div class="flex flex-col md:flex-row w-full max-w-xl mx-auto md:mx-0 gap-4">
              <a href="/StefanCV.pdf" download class="btn-primary w-full md:w-auto">
                <svg class="h-4 w-4 mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M12 3v12" stroke-linecap="round" />
                  <path d="M8 11l4 4 4-4" stroke-linecap="round" stroke-linejoin="round" />
                  <path d="M5 19h14" stroke-linecap="round" />
                </svg>
                Download CV
              </a>
              <a href="/contact" class="btn-secondary w-full md:w-auto">
                Contact Me
              </a>
            </div>
          </article>
        </div>
      </section>

      <!-- WHAT I DO -->
      <section class="section-wrapper bg-[#02080D]">
        <div class="container-custom">
          <div class="mb-16 flex flex-col gap-3 text-center lg:text-left fade-in-up">
            <span class="pill-badge self-center lg:self-start">What I do</span>
            <h2 class="heading-section">What I do</h2>
          </div>

          <div class="grid gap-6 md:grid-cols-2">
            {services.map((service, i) => (
              <article class="card-base fade-in-up" style={`animation-delay: ${100 + i * 100}ms;`}>
                <span class="font-mono text-xs uppercase tracking-[0.2em] text-[#00E5CC] mb-2 block">{service.eyebrow}</span>
                <h3 class="card-title">{service.title}</h3>
                <p class="text-sm font-mono text-gray-400 mb-4">{service.role}</p>
                <p class="text-gray-300 leading-relaxed mb-6 text-sm md:text-base flex-grow">{service.body}</p>
                <div class="flex flex-wrap gap-2">
                  {service.tags.map((tag) => <span class="tag">{tag}</span>)}
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <Certifications class="bg-[#040D14]" />

      <section class="section-wrapper bg-[#02080D]">
        <div class="container-custom">
          <div class="mb-16 flex flex-col gap-3 text-center lg:text-left fade-in-up">
            <span class="pill-badge self-center lg:self-start">My Approach</span>
            <h2 class="heading-section">Minimalism. Logic. Scalability.</h2>
          </div>

          <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
            
            <article class="card-base fade-in-up" style="animation-delay: 100ms;">
              <p class="text-xs uppercase tracking-[0.25em] text-[#00E5CC] font-bold mb-4">01</p>
              <h3 class="card-title">No Code Bloat</h3>
              <p class="text-body flex-grow">Writing clean, maintainable code without unnecessary libraries. Every single line must serve a purpose and never slow down the system.</p>
            </article>

            <article class="card-base fade-in-up" style="animation-delay: 200ms;">
              <p class="text-xs uppercase tracking-[0.25em] text-[#00E5CC] font-bold mb-4">02</p>
              <h3 class="card-title">Enterprise Architecture</h3>
              <p class="text-body flex-grow">Scalable architecture, database integrations, and business automation designed to withstand real-world enterprise loads.</p>
            </article>

            <article class="card-base fade-in-up" style="animation-delay: 300ms;">
              <p class="text-xs uppercase tracking-[0.25em] text-[#00E5CC] font-bold mb-4">03</p>
              <h3 class="card-title">Performance-First UI</h3>
              <p class="text-body flex-grow">Interfaces that don't just look visually striking, but load in milliseconds and provide a flawless user experience across all devices.</p>
            </article>
            
          </div>
        </div>
      </section>

      <section class="section-wrapper bg-[#040D14]">
        <div class="container-custom">
          <div class="rounded-3xl border border-gray-800 bg-[#08131D] p-8 md:p-12 shadow-2xl fade-in-up" style="animation-delay: 400ms;">
            <p class="pill-badge mb-8">Arsenals & Technologies</p>
            <div class="flex flex-wrap gap-3">
              {skills.map((skill) => <span class="tag">{skill}</span>)}
            </div>
          </div>
        </div>
      </section>
    </main>
</BaseLayout>