---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Stefan Stankovic | Services";
const pageDescription = "Core services designed to scale enterprise workflows and connect data.";

const services = [
  {
    eyebrow: 'ENTERPRISE LOGIC',
    title: 'Dynamics 365 F&O Architecture',
    role: 'Intermediate Technical Consultant',
    body: "This is my day-to-day engine. I write robust X++ business logic, execute complex data migrations, and customize modules for large-scale enterprise environments. If your ERP system needs stable, scalable customizations that won't break during Microsoft updates, this is where I come in.",
    tags: ['D365 F&O', 'X++', 'ERP'],
  },
  {
    eyebrow: 'AUTOMATION & APPS',
    title: 'Microsoft Power Platform',
    role: 'Certified Power Platform Developer',
    body: "Bridging the gaps between your disconnected systems. I build custom workflows, model-driven apps, and automated processes using Power Apps, Power Automate and Power Pages. It's all about eliminating manual bottlenecks and securely making your data work for you.",
    tags: ['Power Apps', 'Power Automate', 'Power Pages'],
  },
  {
    eyebrow: 'HIGH-PERFORMANCE UI',
    title: 'Modern Frontend Execution',
    role: 'Full-Stack Developer',
    body: "I don't use heavy, bloated templates. I build lightning-fast, visually precise frontend architectures using Astro and Webflow, strictly styled with utility-first CSS frameworks like Tailwind. The result is a premium digital presence that loads instantly and scales flawlessly across all devices.",
    tags: ['Astro', 'Webflow', 'Tailwind'],
  },
  {
    eyebrow: 'DATA STRUCTURES',
    title: 'Backend & CMS Architecture',
    role: 'Full-Stack Developer',
    body: "A beautiful frontend needs a smart backend. I set up decoupled content architectures using Sanity, Webflow CMS, or dedicated backend engines like Xano. This gives you a secure, intuitive dashboard to manage your content and data without ever having to touch the source code.",
    tags: ['Sanity', 'Webflow CMS', 'Xano'],
  },
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="pt-32">
    <!-- HERO -->
    <section class="container-custom pb-20">
      <div class="text-center lg:text-left max-w-4xl mx-auto lg:mx-0 fade-in-up">
        <span class="pill-badge">Service Line</span>
        <h1 class="heading-page">
          What I bring to the table.
        </h1>
        <p class="text-body max-w-3xl">
          I don't try to be a "jack-of-all-trades." I focus strictly on the technologies where I can deliver top-tier engineering. Here is what I can build for you, and what to expect if we partner up.
        </p>
      </div>
    </section>

    <!-- TIMELINE -->
    <section class="max-w-5xl mx-auto px-4 md:px-8 relative pb-20 overflow-x-hidden">

      <div class="absolute left-[27px] md:left-1/2 top-0 bottom-0 w-px bg-gradient-to-b from-transparent via-[#00E5CC]/50 to-transparent md:-translate-x-1/2 z-0"></div>

      <div class="space-y-12 relative z-10">
        {services.map((service, i) => {
          const isLeft = i % 2 === 0;
          return (
            <article class:list={[
              'reveal-on-scroll opacity-0 translate-y-10 transition-all duration-1000 ease-out relative flex flex-col gap-4 pl-16 md:pl-0',
              isLeft ? 'md:flex-row' : 'md:flex-row-reverse',
            ]}>
              <div class="absolute top-6 z-10 rounded-full shadow-[0_0_15px_rgba(0,229,204,0.4)] h-5 w-5 border-2 border-[#040D14] bg-[#00E5CC] left-[11px] -translate-x-1/2 md:left-1/2 md:border-4"></div>

              <div class:list={['md:w-[calc(50%-3rem)] relative z-10', { 'md:text-right': isLeft }]}>
                <div class="w-full rounded-3xl border border-gray-800 bg-[#0a1520] p-6 md:p-8 shadow-xl transition-all hover:border-[#00E5CC]/50 hover:shadow-[0_0_35px_rgba(0,229,204,0.1)]">
                  <span class="font-mono text-xs uppercase tracking-[0.2em] text-[#00E5CC] mb-2 block">{service.eyebrow}</span>
                  <h3 class="text-2xl font-bold text-white mb-1">{service.title}</h3>
                  <p class="text-sm font-mono text-gray-400 mb-4">{service.role}</p>
                  <p class="text-gray-300 leading-relaxed mb-6 text-sm md:text-base">{service.body}</p>
                  <div class:list={['flex flex-wrap gap-2', { 'md:justify-end': isLeft }]}>
                    {service.tags.map((tag) => <span class="tag">{tag}</span>)}
                  </div>
                </div>
              </div>
              <div class="hidden md:block md:w-[calc(50%-3rem)]"></div>
            </article>
          );
        })}
      </div>
    </section>
  </main>
</BaseLayout>
