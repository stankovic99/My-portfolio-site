---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../utils/content';

const pageTitle = "Stefan Stankovic | Blog";
const pageDescription = "Notes on Dynamics 365 F&O, Power Platform and web development.";

// Svi objavljeni postovi, najnoviji prvi
const posts = await getPosts();
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main id="main" class="pt-32 pb-20">

    <!-- NASLOV -->
    <section class="container-custom mb-12 md:mb-14">
      <div class="max-w-4xl fade-in-up">
        <h1 class="heading-page">Blog</h1>
        <p class="text-body">
          Notes on Dynamics 365 F&O, Power Platform and web development.
        </p>
      </div>
    </section>

    <!-- LISTA POSTOVA: jedna kolona kartica, ista širina kao tekst posta -->
    <section class="container-custom">
      {posts.length === 0 ? (
        <p class="text-body">No posts yet.</p>
      ) : (
        <div class="flex max-w-4xl flex-col gap-6">
          {posts.map((post, i) => (
            <PostCard post={post} class="fade-in-up" style={`animation-delay: ${100 + i * 50}ms;`} />
          ))}
        </div>
      )}
    </section>

  </main>
</BaseLayout>
