---
import { type CollectionEntry, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Prose from "../../components/Prose.astro";
import { getPosts, readingTime, formatDate } from "../../utils/content";

export interface Props {
    entry: CollectionEntry<"blog">;
}

// Draft postovi se ne build-uju
export async function getStaticPaths() {
    const posts = await getPosts();
    return posts.map((entry) => ({
        params: { slug: entry.id },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={`${entry.data.title} | Stefan Stankovic`} description={entry.data.description}>
    <main class="pt-32 pb-20">

        <!-- HEADER POSTA -->
        <header class="container-custom mb-16 border-b border-gray-800 pb-12 pt-4">
            <a href="/blog" class="inline-flex items-center gap-2 font-mono text-sm text-gray-500 hover:text-[#00E5CC] transition-colors mb-10 fade-in-up">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
                Back to Blog
            </a>

            <div class="fade-in-up" style="animation-delay: 100ms;">
                <div class="pill-badge">{entry.data.category ?? "Blog"}</div>
                <h1 class="heading-page">{entry.data.title}</h1>
                <p class="font-mono text-sm text-[#00E5CC]">
                    <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
                    <span aria-hidden="true"> · </span>
                    <span>{readingTime(entry.body)} min read</span>
                </p>
                {entry.data.tags.length > 0 && (
                    <div class="flex flex-wrap gap-2 mt-6">
                        {entry.data.tags.map((tag) => (
                            <span class="tag">{tag}</span>
                        ))}
                    </div>
                )}
            </div>
        </header>

        <!-- SADRŽAJ (Markdown telo posta) -->
        <section class="container-custom">
            <Prose class="fade-in-up" style="animation-delay: 200ms;">
                <Content />
            </Prose>
        </section>

    </main>
</BaseLayout>
